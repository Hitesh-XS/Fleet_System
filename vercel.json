{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "django",
      "environment": {
        "DJANGO_SETTINGS_MODULE": "YOUR_FOLDER_NAME.settings"
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}